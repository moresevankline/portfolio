---
import '@fontsource-variable/sofia-sans-condensed';

const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
// Contact address as shifted char codes; decoded only when Copy email is clicked.
const mailCodes = [...'ekmores28@gmail.com'].map((c) => c.charCodeAt(0) + 7).join('.');

const zones = [
  { id: 'web', name: 'Web', tone: 'ink', covers: 'Websites and web apps built to be fast, accessible, and easy to maintain.' },
  { id: 'ec-core', name: 'EC Core', tone: 'ec', covers: 'Employee Central foundation objects, employee data, and position management.' },
  { id: 'time-off', name: 'Time Off', tone: 'to', covers: 'Time Off setup: time types, accrual rules, and leave approvals.' },
  { id: 'reporting', name: 'Reporting', tone: 'rep', covers: 'Reports on SuccessFactors people data, built for the HR teams who read them.' },
];

const certs = [
  { title: 'SAP Certified - SAP SuccessFactors Employee Central Core and Position Management', url: 'https://www.credly.com/badges/6519d5c7-5f2c-49c7-a084-715b848cf7e0' },
  { title: 'SAP Certified - SAP Generative AI Developer', url: 'https://www.credly.com/badges/a9ff526e-f1d1-4bbc-ad6c-5cef9cb8425b' },
];

// Decorative barcode: bar widths derived from the name, drawn once at build time.
const bars: { x: number; w: number }[] = [];
let x = 0;
for (const ch of 'EVANKLINEMORES') {
  const c = ch.charCodeAt(0);
  for (let i = 0; i < 4; i++) {
    const w = ((c >> i) & 1) + 1 + (i === 3 ? 1 : 0);
    bars.push({ x, w });
    x += w + ((c >> (i + 2)) & 1) + 1;
  }
}
const barWidth = x;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Evan Kline Mores · Web developer, SAP SuccessFactors</title>
  <meta name="description" content="Evan Kline Mores is a web developer who knows how HR runs on SAP SuccessFactors: Employee Central Core, Time Off, and Reporting." />
  <meta name="theme-color" content="#f1efe9" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#message">Skip to contact</a>

  <nav class="strap" aria-label="Sections">
    <span class="strap-name">Evan Kline Mores</span>
    <ul>
      <li><a href="#top" data-nav="top">Badge</a></li>
      <li><a href="#access" data-nav="access">Access</a></li>
      <li><a href="#certified" data-nav="certified">Certified</a></li>
      <li><a href="#return" data-nav="return">Contact</a></li>
    </ul>
    <button type="button" class="strap-menu-btn" popovertarget="nav-sheet" aria-label="Open menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="3" fill="none" /></svg>
    </button>
    <div id="nav-sheet" class="strap-sheet" popover>
      <div class="strap-grip" aria-hidden="true"></div>
      <ul>
        <li><a href="#top" data-nav="top" onclick="this.closest('[popover]').hidePopover()">Badge</a></li>
        <li><a href="#access" data-nav="access" onclick="this.closest('[popover]').hidePopover()">Access</a></li>
        <li><a href="#certified" data-nav="certified" onclick="this.closest('[popover]').hidePopover()">Certified</a></li>
        <li><a href="#return" data-nav="return" onclick="this.closest('[popover]').hidePopover()">Contact</a></li>
      </ul>
      <button type="button" class="strap-close" popovertarget="nav-sheet" popovertargetaction="hide">Close</button>
    </div>
  </nav>

  <main class="nb-main">
    <section class="nb-front" id="top" data-section="top" aria-label="Introduction">
      <div class="nb-intro">
        <p class="nb-lede">Web developer who knows how HR runs on <mark>SAP SuccessFactors.</mark></p>
        <p class="nb-proof">Certified in SuccessFactors Employee Central Core and SAP Generative AI. <a href="#certified">See certifications</a></p>
      </div>
      <div class="nb-hang">
        <div class="nb-strap" aria-hidden="true"></div>
        <article class="nb-badge" aria-labelledby="nb-name">
          <div class="nb-slot" aria-hidden="true"></div>
          <h1 id="nb-name" class="nb-name">Evan Kline<br />Mores</h1>
          <p class="nb-position">Web developer · SAP SuccessFactors</p>
          <ul class="nb-zones" aria-label="Access zones">
            {zones.map((z) => (<li><a class={`nb-zone nb-${z.tone === 'ink' ? 'web' : z.tone}`} href={`#${z.id}`} data-zone={z.id}>{z.name}</a></li>))}
          </ul>
          {formKey ? (
          <form id="message" class="nb-contact" action="https://api.web3forms.com/submit" method="POST" novalidate>
            <h2>Send a message</h2>
            <input type="hidden" name="access_key" value={formKey} />
            <input type="hidden" name="subject" value="Message from your portfolio" />
                <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label class="nb-field"><span>Your email</span><input type="email" name="email" autocomplete="email" required placeholder="you@company.com" /></label>
            <label class="nb-field"><span>What are you working on?</span><textarea name="message" rows="2" required placeholder="A role, a project, a SuccessFactors question…"></textarea></label>
            <div class="nb-actions"><button type="submit" class="nb-btn send">Send</button><p class="status" role="status" aria-live="polite"></p></div>
          </form>
          ) : (
          <div id="message" class="nb-contact" data-copy-scope>
            <h2>Get in touch</h2>
            <div class="nb-actions">
              <button type="button" class="nb-btn" data-copy data-m={mailCodes}>Copy email</button>
              <a class="nb-link" href="https://www.linkedin.com/in/evanklinemores" target="_blank" rel="noopener">LinkedIn <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="2.5" /></svg><span class="sr">(opens in a new tab)</span></a>
            </div>
            <p class="copy-status" role="status" aria-live="polite"></p>
          </div>
          )}
          <svg class="nb-barcode" viewBox={`0 0 ${barWidth} 40`} preserveAspectRatio="none" aria-hidden="true">
            {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="40" fill="currentColor" />)}
          </svg>
        </article>
      </div>
    </section>

    <section class="nb-sec" id="access" data-section="access" aria-labelledby="nb-access-h">
      <h2 id="nb-access-h" class="nb-display">Access</h2>
      <p class="nb-sub">What each zone on the badge covers.</p>
      <dl class="nb-access">
        {zones.map((z) => (
          <div class="nb-row access-row" id={z.id} data-section="access">
            <dt><span class={`nb-tag nb-${z.tone === 'ink' ? 'web' : z.tone}`}>{z.name}</span></dt>
            <dd>{z.covers}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="nb-sec" id="certified" data-section="certified" aria-labelledby="nb-cert-h">
      <h2 id="nb-cert-h" class="nb-display">Certified</h2>
      <ul class="nb-certs">
        {certs.map((c) => (
          <li>
            <span class="nb-cert">{c.title}</span>
            <a class="nb-link" href={c.url} target="_blank" rel="noopener">Verify on Credly <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="2.5" /></svg><span class="sr">(opens in a new tab)</span></a>
          </li>
        ))}
      </ul>
    </section>

    <section class="nb-sec nb-return" id="return" data-section="return" aria-labelledby="nb-return-h" data-copy-scope>
      <h2 id="nb-return-h">If found, please return to Evan Kline Mores</h2>
      <div class="nb-actions">
        <button type="button" class="nb-btn" data-copy data-m={mailCodes}>Copy email</button>
        <a class="nb-link" href="https://www.linkedin.com/in/evanklinemores" target="_blank" rel="noopener">LinkedIn <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="2.5" /></svg><span class="sr">(opens in a new tab)</span></a>
        {formKey && <a class="nb-link" href="#message">Send a message</a>}
      </div>
      <p class="copy-status" role="status" aria-live="polite"></p>
      <p class="nb-small">This badge is not transferable. Web development, SAP SuccessFactors Employee Central Core, Time Off, and Reporting. Certifications verified on Credly. © {new Date().getFullYear()} Evan Kline Mores.</p>
    </section>
  </main>

  <script>
    // Form: Web3Forms over fetch; a plain POST still works without JS.
    const form = document.querySelector<HTMLFormElement>('form#message');
    if (form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const send = form.querySelector<HTMLButtonElement>('.send')!;
    const say = (text: string, tone = '') => { status.textContent = text; status.dataset.tone = tone; };


    form.addEventListener('input', () => { if (status.dataset.tone === 'error') say(''); });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.elements.namedItem('email') as HTMLInputElement;
      const msg = form.elements.namedItem('message') as HTMLTextAreaElement;
      if (!email.checkValidity()) { say('Enter an email address like name@company.com.', 'error'); email.focus(); return; }
      if (!msg.value.trim()) { say('Add a line about what you’re working on.', 'error'); msg.focus(); return; }
      send.disabled = true; send.textContent = 'Sending…'; say('');
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error();
        form.classList.add('sent');
        say(`Sent. Evan Kline Mores will reply to ${email.value}.`, 'ok');
        form.reset();
        send.textContent = 'Sent';
      } catch {
        send.disabled = false; send.textContent = 'Send';
        say('Couldn’t send. Try again, or use Copy email at the bottom.', 'error');
      }
    });

    }

    // Copy email: assembled at click time so the address never sits in the page source.
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((copyBtn) => copyBtn.addEventListener('click', async () => {
      const copyStatus = copyBtn.closest('[data-copy-scope]')!.querySelector<HTMLElement>('.copy-status')!;
      const address = String.fromCharCode(...copyBtn.dataset.m!.split('.').map((n) => Number(n) - 7));
      try {
        await navigator.clipboard.writeText(address);
        copyStatus.textContent = `Copied ${address}`;
      } catch {
        copyStatus.textContent = `Copy this address: ${address}`;
      }
    }));


    // Strap names the section in view; zones mark the one being read.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
    const zoneLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-zone]')];
    const sections = [...document.querySelectorAll<HTMLElement>('section[data-section]')];
    const rows = [...document.querySelectorAll<HTMLElement>('.access-row')];
    // aria-current needs a real value; an empty attribute reads as "not current".
    const mark = (list: HTMLAnchorElement[], key: 'nav' | 'zone', value: string | undefined) =>
      list.forEach((a) => (a.dataset[key] === value ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));

    // The section crossing 45% of the viewport is current. The last sections can't scroll that far,
    // so the page bottom counts as Contact unless a link was just clicked to a section still on screen.
    let clicked: string | undefined;
    const update = () => {
      const line = innerHeight * 0.45;
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      let sec = sections.filter((s) => s.getBoundingClientRect().top <= line).at(-1)?.dataset.section ?? 'top';
      if (atBottom) {
        const target = clicked && document.querySelector(`[data-section="${clicked}"]`);
        sec = target && target.getBoundingClientRect().top < innerHeight ? clicked! : 'return';
      }
      mark(links, 'nav', sec);
      const row = rows.find((r) => { const b = r.getBoundingClientRect(); return b.top <= line && b.bottom >= line; });
      mark(zoneLinks, 'zone', row?.id);
    };
    let queued = false;
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; update(); }); } }, { passive: true });
    addEventListener('resize', update);
    links.forEach((a) => a.addEventListener('click', () => { clicked = a.dataset.nav; mark(links, 'nav', clicked); }));
    // Any scrolling the visitor does by hand drops the remembered click.
    const forget = () => { if (clicked) { clicked = undefined; requestAnimationFrame(update); } };
    for (const ev of ['wheel', 'touchstart']) addEventListener(ev, forget, { passive: true });
    addEventListener('keydown', (e) => { if (!['Enter', ' ', 'Tab', 'Shift'].includes(e.key)) forget(); });
    update();
  </script>
</body>
</html>

<style is:global>
  /* Designed at 1440px. Wider screens scale the whole page up, like zoom: --px and the root font size
     grow with the viewport, and the vw-based sizes keep growing with them. */
  :root {
    --px: 1px;
    --paper: #f1efe9;
    --card: #ffffff;
    --ink: #111214;
    --web: #111214;
    --ec: #0f8f80;
    --to: #ffc93c;
    --rep: #4f6bed;
    --err: #b3261e;
    --ok: #0f6e5f;
    --off: calc(8 * var(--px));
    --face: 'Sofia Sans Condensed Variable', 'Arial Narrow', sans-serif;
    --text: 1.0625rem;
    --gutter: clamp(1rem, 4vw, 4rem);
    color-scheme: light;
  }
  @media (min-width: 1441px) {
    :root { --px: calc(100vw / 1440); }
    html { font-size: calc(100vw / 90); }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 4rem; scrollbar-color: var(--ink) var(--paper); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 450 var(--text)/1.45 var(--face);
    -webkit-font-smoothing: antialiased;
    caret-color: var(--ink);
  }
  ::selection { background: var(--to); color: var(--ink); }
  h1, h2, p, ul, dl, dd { margin: 0; }
  ul { padding: 0; list-style: none; }
  a { color: inherit; text-underline-offset: 0.2em; text-decoration-thickness: calc(2 * var(--px)); }
  :focus-visible { outline: calc(3 * var(--px)) solid var(--rep); outline-offset: calc(3 * var(--px)); }
  .sr { position: absolute; width: calc(1 * var(--px)); height: calc(1 * var(--px)); overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 10; background: var(--ink); color: var(--to); padding: 0.6rem 1rem; font-weight: 800; }
  .skip:focus { top: 1rem; }

  /* Strap: the lanyard as a printed rail. Paper bar, ink rule, boxed links; the section in view is inked in. */
  .strap {
    position: sticky; top: 0; z-index: 5;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    height: 3.5rem; padding: 0 var(--gutter);
    background: var(--paper); color: var(--ink);
    border-bottom: calc(3 * var(--px)) solid var(--ink);
    font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .strap-name { white-space: nowrap; font-weight: 900; font-size: 1.15rem; letter-spacing: 0.04em; background: var(--ink); color: var(--to); padding: 0.3rem 0.6rem; }
  .strap ul { display: flex; gap: clamp(0.4rem, 1.2vw, 0.75rem); }
  .strap a {
    display: block; text-decoration: none; padding: 0.45rem 0.7rem;
    border: calc(3 * var(--px)) solid transparent;
    transition: translate .12s ease-out, box-shadow .12s ease-out, background-color .12s ease-out;
  }
  @media (hover: hover) { .strap a:hover { background: var(--to); border-color: var(--ink); box-shadow: calc(3 * var(--px)) calc(3 * var(--px)) 0 var(--ink); translate: calc(-1 * var(--px)) calc(-1 * var(--px)); } }
  .strap a[aria-current] { background: var(--ink); color: var(--to); border-color: var(--ink); box-shadow: calc(3 * var(--px)) calc(3 * var(--px)) 0 var(--rep); }
  .strap a:active { translate: calc(2 * var(--px)) calc(2 * var(--px)); box-shadow: none; }
  .strap a:focus-visible { outline: calc(3 * var(--px)) solid var(--rep); outline-offset: calc(2 * var(--px)); }
  @media (prefers-reduced-motion: reduce) { .strap a { transition: none; } }

  /* Phone menu: below calc(720 * var(--px)) the links fold into a bottom sheet (native popover). */
  .strap-menu-btn { display: none; }
  @media (max-width: 720px) {
  .strap > ul { display: none; }
  .strap-name { font-size: 1rem; }
  .strap-menu-btn { display: inline-flex; }
  }

  .strap-menu-btn { align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; padding: 0; background: var(--ink); color: var(--to); border: calc(3 * var(--px)) solid var(--ink); box-shadow: calc(3 * var(--px)) calc(3 * var(--px)) 0 var(--rep); cursor: pointer; transition: translate .12s ease-out, box-shadow .12s ease-out; }
  .strap-menu-btn:active { translate: calc(3 * var(--px)) calc(3 * var(--px)); box-shadow: none; }
  .strap-menu-btn svg { width: 1.4rem; height: 1.4rem; }
  .strap-sheet { position: fixed; inset: auto 0 0 0; width: 100%; max-width: none; margin: 0; border: 0; border-top: calc(4 * var(--px)) solid var(--ink); padding: 0.75rem var(--gutter) calc(1.25rem + env(safe-area-inset-bottom)); background: var(--paper); color: var(--ink); }
  .strap-sheet::backdrop { background: rgb(17 18 20 / 0.45); }
  .strap-grip { width: 6rem; height: 1rem; margin: 0 auto 1rem; border: calc(3 * var(--px)) solid var(--ink); border-radius: calc(999 * var(--px)); background: var(--card); }
  .strap .strap-sheet ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; width: auto; justify-content: stretch; }
  .strap .strap-sheet a { display: flex; align-items: flex-end; min-height: 5.5rem; padding: 0.7rem 0.8rem; font-size: 1.4rem; font-weight: 900; letter-spacing: 0.04em; text-transform: uppercase; background: var(--card); border: calc(3 * var(--px)) solid var(--ink); box-shadow: calc(4 * var(--px)) calc(4 * var(--px)) 0 var(--ink); }
  @media (hover: hover) { .strap .strap-sheet a:hover { background: var(--to); translate: calc(-2 * var(--px)) calc(-2 * var(--px)); box-shadow: calc(6 * var(--px)) calc(6 * var(--px)) 0 var(--ink); } }
  .strap .strap-sheet a[aria-current] { background: var(--ink); color: var(--to); box-shadow: calc(4 * var(--px)) calc(4 * var(--px)) 0 var(--rep); }
  .strap-close { display: block; width: 100%; margin-top: 1rem; height: 3rem; font: inherit; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; background: var(--to); color: var(--ink); border: calc(3 * var(--px)) solid var(--ink); box-shadow: calc(4 * var(--px)) calc(4 * var(--px)) 0 var(--ink); cursor: pointer; }
  .strap-close:active { translate: calc(4 * var(--px)) calc(4 * var(--px)); box-shadow: none; }
  .strap-sheet { transition: translate .35s cubic-bezier(.16,1,.3,1), overlay .35s allow-discrete, display .35s allow-discrete; translate: 0 100%; }
  .strap-sheet:popover-open { translate: 0 0; }
  @starting-style { .strap-sheet:popover-open { translate: 0 100%; } }

  @media (prefers-reduced-motion: reduce) { .strap-sheet { transition: none; } }

  .trap { position: absolute; left: -9999px; }
  .copy-status { margin-top: 0.75rem; min-height: 1.45em; font-weight: 600; }
  .status { flex: 1 1 12rem; font-weight: 700; }
  .status[data-tone='error'] { color: var(--err); }
  .status[data-tone='ok'] { color: var(--ok); }
  .nb-zone[aria-current] { outline: calc(3 * var(--px)) solid var(--ink); outline-offset: calc(3 * var(--px)); }
  .send:disabled { cursor: not-allowed; opacity: 0.6; translate: none; box-shadow: none; }

  /* Neo-brutalist access pass: paper ground, ink borders, hard block shadows, zones as colour blocks */
  .nb-main {
  overflow-x: hidden;
  background: var(--paper); color: var(--ink);
  padding: clamp(1.5rem, 4vw, 3rem) var(--gutter) 4rem;
  }
  .nb-front { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 1101px) { .nb-front { grid-template-columns: minmax(0, 1fr) minmax(0, 30rem); column-gap: clamp(2rem, 6vw, 6rem); min-height: calc(100svh - 7rem); } }
  .nb-intro { align-self: center; display: grid; gap: 1.5rem; }
  .nb-lede { font-size: clamp(3rem, 1.8rem + 4.4vw, 6rem); font-weight: 900; line-height: 0.9; letter-spacing: -0.02em; text-transform: uppercase; max-width: 12ch; text-wrap: balance; }
  .nb-lede mark { background: var(--to); color: var(--ink); padding: 0 0.12em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .nb-proof { font-size: 1.2rem; font-weight: 700; max-width: 34ch; border: calc(3 * var(--px)) solid var(--ink); background: var(--card); padding: 1rem 1.25rem; box-shadow: calc(5 * var(--px)) calc(5 * var(--px)) 0 var(--ink); }
  .nb-proof a { font-weight: 900; text-decoration-thickness: calc(3 * var(--px)); white-space: nowrap; }
  .nb-hang { position: relative; padding-top: 4rem; }
  .nb-strap { position: absolute; left: 50%; top: 0; translate: -50% 0; width: 3.25rem; height: 5rem; background: var(--ink); border: calc(3 * var(--px)) solid var(--ink); }
  .nb-strap::after { content: ""; position: absolute; left: 50%; bottom: -1.25rem; translate: -50% 0; width: 4.5rem; height: 1.75rem; background: var(--to); border: calc(3 * var(--px)) solid var(--ink); }
  .nb-badge { position: relative; background: var(--card); border: calc(4 * var(--px)) solid var(--ink); box-shadow: var(--off) var(--off) 0 var(--ink); padding: 1.5rem 1.5rem 1.25rem; rotate: -2deg; transform-origin: 50% 0; }
  .nb-slot { width: 6rem; height: 1rem; margin: 0 auto 1.25rem; border: calc(3 * var(--px)) solid var(--ink); border-radius: calc(999 * var(--px)); background: var(--paper); }
  .nb-name { font-size: clamp(3rem, 2rem + 3.4vw, 5rem); font-weight: 900; line-height: 0.84; letter-spacing: -0.02em; text-transform: uppercase; }
