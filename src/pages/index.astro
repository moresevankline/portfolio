---
import '@fontsource-variable/sofia-sans-condensed';

const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
// Contact address as shifted char codes; decoded only when Copy email is clicked.
const mailCodes = [...'ekmores28@gmail.com'].map((c) => c.charCodeAt(0) + 7).join('.');

const zones = [
  { id: 'web', name: 'Web', tone: 'ink', covers: 'Websites and web apps built to be fast, accessible, and easy to maintain.' },
  { id: 'ec-core', name: 'EC Core', tone: 'ec', covers: 'Employee Central foundation objects, employee data, and position management.' },
  { id: 'time-off', name: 'Time Off', tone: 'to', covers: 'Time Off setup: time types, accrual rules, and leave approvals.' },
  { id: 'reporting', name: 'Reporting', tone: 'rep', covers: 'Reports on SuccessFactors people data, built for the HR teams who read them.' },
];

const certs = [
  { title: 'SAP Certified - SAP SuccessFactors Employee Central Core and Position Management', url: 'https://www.credly.com/badges/6519d5c7-5f2c-49c7-a084-715b848cf7e0' },
  { title: 'SAP Certified - SAP Generative AI Developer', url: 'https://www.credly.com/badges/a9ff526e-f1d1-4bbc-ad6c-5cef9cb8425b' },
];

// Decorative barcode: bar widths derived from the name, drawn once at build time.
const bars: { x: number; w: number }[] = [];
let x = 0;
for (const ch of 'EVANKLINEMORES') {
  const c = ch.charCodeAt(0);
  for (let i = 0; i < 4; i++) {
    const w = ((c >> i) & 1) + 1 + (i === 3 ? 1 : 0);
    bars.push({ x, w });
    x += w + ((c >> (i + 2)) & 1) + 1;
  }
}
const barWidth = x;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Evan Kline Mores · Web developer, SAP SuccessFactors</title>
  <meta name="description" content="Evan Kline Mores is a web developer who knows how HR runs on SAP SuccessFactors: Employee Central Core, Time Off, and Reporting." />
  <meta name="theme-color" content="#121416" data-dark="#121416" data-light="#e6e8eb" />
  <script is:inline>
    // Pick the theme before first paint: saved choice, else the system setting.
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.dataset.theme = t;
      var m = document.querySelector('meta[name="theme-color"]');
      m.content = m.dataset[t];
    })();
  </script>
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#message">Skip to contact</a>

  <nav class="strap" aria-label="Sections">
    <span class="strap-name">Evan Kline Mores</span>
    <ul>
      <li><a href="#top" data-nav="top">Badge</a></li>
      <li><a href="#access" data-nav="access">Access</a></li>
      <li><a href="#certified" data-nav="certified">Certified</a></li>
      <li><a href="#return" data-nav="return">Contact</a></li>
    </ul>
    <button type="button" class="theme" aria-label="Switch to light mode" title="Switch to light mode">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" /></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" /></svg>
    </button>
  </nav>

  <main>
    <section class="front" id="top" data-section="top" aria-label="Introduction">
      <canvas class="particles" aria-hidden="true"></canvas>
      <p class="lede">Web developer who knows how HR runs on SAP SuccessFactors.</p>
      <p class="proof">Certified in SuccessFactors Employee Central Core and SAP Generative AI. <a href="#certified">See certifications</a></p>

      <div class="hang">
        <div class="lanyard" aria-hidden="true">
          <span>Web · EC Core · Time Off · Reporting · Web · EC Core · Time Off · Reporting</span>
        </div>
        <svg class="clip" viewBox="0 0 64 56" aria-hidden="true">
          <path d="M14 20h36a6 6 0 0 1 6 6v8a6 6 0 0 1-6 6H40v16H24V40H14a6 6 0 0 1-6-6v-8a6 6 0 0 1 6-6Z" fill="#9aa2a8" />
          <path d="M14 20h36a6 6 0 0 1 6 6v2H8v-2a6 6 0 0 1 6-6Z" fill="#c3c9cd" />
        </svg>

        <article class="badge" aria-labelledby="name">
          <div class="slot" aria-hidden="true"></div>
          <div class="foil" aria-hidden="true"></div>
          <h1 id="name" class="name">Evan Kline<br />Mores</h1>
          <p class="position">Web developer · SAP SuccessFactors</p>

          <ul class="zones" aria-label="Access zones">
            {zones.map((z) => (
              <li><a class={`zone tone-${z.tone}`} href={`#${z.id}`} data-zone={z.id}>{z.name}</a></li>
            ))}
          </ul>

          {formKey ? (
          <form id="message" class="form" action="https://api.web3forms.com/submit" method="POST" novalidate>
            <h2 class="form-title">Send a message</h2>
            <input type="hidden" name="access_key" value={formKey} />
            <input type="hidden" name="subject" value="Message from your portfolio" />
            <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label class="field">
              <span>Your email</span>
              <input type="email" name="email" autocomplete="email" required placeholder="you@company.com" />
            </label>
            <label class="field">
              <span>What are you working on?</span>
              <textarea name="message" rows="1" required placeholder="A role, a project, a SuccessFactors question…"></textarea>
            </label>
            <div class="send-row">
              <button type="submit" class="send">Send</button>
              <p class="status" role="status" aria-live="polite"></p>
            </div>
          </form>
          ) : (
          <div id="message" class="form badge-contact" data-copy-scope>
            <h2 class="form-title">Get in touch</h2>
            <div class="contact-actions">
              <button type="button" class="copy" data-copy data-m={mailCodes}>Copy email</button>
              <a class="out" href="https://www.linkedin.com/in/evanklinemores" target="_blank" rel="noopener">
                LinkedIn
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                <span class="sr">(opens in a new tab)</span>
              </a>
            </div>
            <p class="copy-status" role="status" aria-live="polite"></p>
          </div>
          )}

          <svg class="barcode" viewBox={`0 0 ${barWidth} 40`} preserveAspectRatio="none" aria-hidden="true">
            {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="40" fill="currentColor" />)}
          </svg>
        </article>
      </div>
    </section>

    <div class="back">
      <div class="slot" aria-hidden="true"></div>

      <section id="access" data-section="access" aria-labelledby="access-h">
        <h2 id="access-h" class="display">Access</h2>
        <p class="intro">What each zone on the badge covers.</p>
        <dl class="access">
          {zones.map((z) => (
            <div class="access-row" id={z.id} data-section="access">
              <dt><span class={`tag tone-${z.tone}`}>{z.name}</span></dt>
              <dd>{z.covers}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="certified" data-section="certified" aria-labelledby="certified-h">
        <h2 id="certified-h" class="display">Certified</h2>
        <ul class="certs">
          {certs.map((c) => (
            <li>
              <span class="cert-title">{c.title}</span>
              <a class="verify" href={c.url} target="_blank" rel="noopener">
                Verify on Credly
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                <span class="sr">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section id="return" data-section="return" class="return" aria-labelledby="return-h" data-copy-scope>
        <h2 id="return-h" class="display">If found, please return to Evan Kline Mores</h2>
        <div class="return-actions">
          <button type="button" class="copy" data-copy data-m={mailCodes}>Copy email</button>
          <a class="out" href="https://www.linkedin.com/in/evanklinemores" target="_blank" rel="noopener">
            LinkedIn
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            <span class="sr">(opens in a new tab)</span>
          </a>
          {formKey && <a class="out" href="#message">Send a message</a>}
        </div>
        <p class="copy-status" role="status" aria-live="polite"></p>
        <p class="small-print"><span class="small-extra">Not transferable. Certifications verified on Credly. </span>© {new Date().getFullYear()} Evan Kline Mores.</p>
      </section>
    </div>
  </main>

  <script>
    // Form: Web3Forms over fetch; a plain POST still works without JS.
    const form = document.querySelector<HTMLFormElement>('form#message');
    if (form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const send = form.querySelector<HTMLButtonElement>('.send')!;
    const say = (text: string, tone = '') => { status.textContent = text; status.dataset.tone = tone; };


    form.addEventListener('input', () => { if (status.dataset.tone === 'error') say(''); });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.elements.namedItem('email') as HTMLInputElement;
      const msg = form.elements.namedItem('message') as HTMLTextAreaElement;
      if (!email.checkValidity()) { say('Enter an email address like name@company.com.', 'error'); email.focus(); return; }
      if (!msg.value.trim()) { say('Add a line about what you’re working on.', 'error'); msg.focus(); return; }
      send.disabled = true; send.textContent = 'Sending…'; say('');
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error();
        form.classList.add('sent');
        say(`Sent. Evan Kline Mores will reply to ${email.value}.`, 'ok');
        form.reset();
        send.textContent = 'Sent';
      } catch {
        send.disabled = false; send.textContent = 'Send';
        say('Couldn’t send. Try again, or use Copy email at the bottom.', 'error');
      }
    });

    }

    // Copy email: assembled at click time so the address never sits in the page source.
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((copyBtn) => copyBtn.addEventListener('click', async () => {
      const copyStatus = copyBtn.closest('[data-copy-scope]')!.querySelector<HTMLElement>('.copy-status')!;
      const address = String.fromCharCode(...copyBtn.dataset.m!.split('.').map((n) => Number(n) - 7));
      try {
        await navigator.clipboard.writeText(address);
        copyStatus.textContent = `Copied ${address}`;
      } catch {
        copyStatus.textContent = `Copy this address: ${address}`;
      }
    }));

    // Foil strip follows the pointer.
    const badge = document.querySelector<HTMLElement>('.badge')!;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      badge.addEventListener('pointermove', (e) => {
        const r = badge.getBoundingClientRect();
        badge.style.setProperty('--fx', ((e.clientX - r.left) / r.width).toFixed(3));
        badge.style.setProperty('--fy', ((e.clientY - r.top) / r.height).toFixed(3));
      });
    }

    // Particles behind the front: faint dots drift up; the pointer shifts them a little, bigger dots more (depth).
    const canvas = document.querySelector<HTMLCanvasElement>('.particles');
    const front = document.querySelector<HTMLElement>('.front');
    if (canvas && front) {
      const ctx = canvas.getContext('2d')!;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const readInk = () => getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#ecedee';
      let ink = readInk();
      type Dot = { x: number; y: number; r: number; a: number; vx: number; vy: number };
      let w = 0, h = 0, dots: Dot[] = [], frame = 0, onScreen = true;
      const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
      const makeDot = (): Dot => ({
        x: Math.random() * w, y: Math.random() * h,
        r: 0.6 + Math.random() * 1.4, a: 0.12 + Math.random() * 0.4,
        vx: (Math.random() - 0.5) * 0.1, vy: -(0.04 + Math.random() * 0.1),
      });
      const draw = () => {
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = ink;
        for (const d of dots) {
          ctx.globalAlpha = d.a;
          ctx.beginPath();
          ctx.arc(d.x + pointer.x * d.r * 8, d.y + pointer.y * d.r * 8, d.r, 0, Math.PI * 2);
          ctx.fill();
        }
      };
      const resize = () => {
        const dpr = Math.min(devicePixelRatio || 1, 2);
        w = front.clientWidth; h = front.clientHeight;
        canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const want = Math.min(140, Math.round((w * h) / 12000));
        while (dots.length < want) dots.push(makeDot());
        dots.length = want;
        draw();
      };
      const tick = () => {
        pointer.x += (pointer.tx - pointer.x) * 0.05;
        pointer.y += (pointer.ty - pointer.y) * 0.05;
        for (const d of dots) {
          d.x = (d.x + d.vx + w) % w;
          d.y += d.vy;
          if (d.y < -4) { d.y = h + 4; d.x = Math.random() * w; }
        }
        draw();
        frame = requestAnimationFrame(tick);
      };
      // Run only while the front is on screen and the tab is visible.
      const sync = () => {
        cancelAnimationFrame(frame);
        if (!still && onScreen && !document.hidden) frame = requestAnimationFrame(tick);
      };
      new ResizeObserver(resize).observe(front);
      new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; sync(); }).observe(front);
      document.addEventListener('visibilitychange', sync);
      document.addEventListener('themechange', () => { ink = readInk(); draw(); });
      if (!still) front.addEventListener('pointermove', (e) => {
        const r = front.getBoundingClientRect();
        pointer.tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        pointer.ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
      });
    }

    // Theme toggle: flips data-theme, remembers the choice, keeps label, tooltip and browser colour in step.
    const themeBtn = document.querySelector<HTMLButtonElement>('.theme')!;
    const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!;
    const setTheme = (next: 'light' | 'dark', save: boolean) => {
      document.documentElement.dataset.theme = next;
      if (save) try { localStorage.setItem('theme', next); } catch {}
      const label = next === 'light' ? 'Switch to dark mode' : 'Switch to light mode';
      themeBtn.setAttribute('aria-label', label);
      themeBtn.title = label;
      themeMeta.content = themeMeta.dataset[next]!;
      document.dispatchEvent(new Event('themechange'));
    };
    setTheme(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark', false);
    themeBtn.addEventListener('click', () => setTheme(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light', true));
    // Without a saved choice, follow the system when it switches while the page is open.
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
      let saved: string | null = null;
      try { saved = localStorage.getItem('theme'); } catch {}
      if (saved !== 'light' && saved !== 'dark') setTheme(e.matches ? 'light' : 'dark', false);
    });

    // Strap names the section in view; zones mark the one being read.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
    const zoneLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-zone]')];
    // An empty aria-current reads as "false", so set a real value.
    const mark = (a: HTMLElement, on: boolean) => on ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current');
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        const sec = (en.target as HTMLElement).dataset.section!;
        links.forEach((a) => mark(a, a.dataset.nav === sec));
      }
    }, { rootMargin: '-45% 0px -50% 0px' });
    document.querySelectorAll('section[data-section]').forEach((s) => io.observe(s));
    // Zones mark the highest access row in the top half under the strap (where a clicked row lands); none there clears them.
    const rows = [...document.querySelectorAll<HTMLElement>('.access-row')];
    const inBand = new Set<Element>();
    const zoneIo = new IntersectionObserver((entries) => {
      for (const en of entries) en.isIntersecting ? inBand.add(en.target) : inBand.delete(en.target);
      const top = rows.find((r) => inBand.has(r));
      zoneLinks.forEach((a) => mark(a, a.dataset.zone === top?.id));
    }, { rootMargin: '-80px 0px -50% 0px' });
    rows.forEach((r) => zoneIo.observe(r));
  </script>
</body>
</html>

<style is:global>
  :root {
    --ground: #121416;
    --pvc: #1d2024;
    --ink: #ecedee;
    --ink-2: #a7adb4;
    --strap: #2a2f35;
    --accent: #6fd3c3;
    --hair: #33383e;
    --placeholder: #8b9198;
    --ec: #17786d;
    --to: #c9a640;
    --rep: #55667a;
    --on-zone: #ffffff;
    --ok: #7ad7a3;
    --err: #ff9a90;
    --on-accent: #121416;
    --strap-ink: #ecedee;
    --face: 'Sofia Sans Condensed Variable', 'Arial Narrow', sans-serif;
    --display: clamp(2.75rem, 1.6rem + 3.6vw, 5.25rem);
    --text: 1.0625rem;
    --gutter: clamp(1rem, 4vw, 4rem);
    color-scheme: dark;
  }
  /* Light theme: pale grey ground, white PVC, graphite ink. The strap and lanyard stay dark fabric. */
  :root[data-theme='light'] {
    --ground: #e6e8eb;
    --pvc: #fbfbfc;
    --ink: #16191c;
    --ink-2: #555c64;
    --hair: #d3d7dc;
    --placeholder: #6b7179;
    --ok: #1e7a4c;
    --err: #b42318;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  /* Past 1440px the page scales as a whole: 1rem = 1/90 of the width, so margins, type and the badge keep their 1440 proportions. */
  @media (min-width: 1441px) { html { font-size: max(100%, calc(100vw / 90)); } }
  html { scroll-behavior: smooth; scroll-padding-top: 4rem; scrollbar-color: var(--strap) var(--ground); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font: 450 var(--text)/1.45 var(--face);
    -webkit-font-smoothing: antialiased;
    caret-color: var(--accent);
  }
  ::selection { background: var(--accent); color: var(--on-accent); }
  h1, h2, p, ul, dl, dd { margin: 0; }
  p, dd { text-wrap: pretty; }
  ul { padding: 0; list-style: none; }
  a { color: inherit; text-underline-offset: 0.2em; text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px dashed var(--ink); outline-offset: 3px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 10; background: var(--ink); color: var(--pvc); padding: 0.6rem 1rem; font-weight: 700; }
  .skip:focus { top: 1rem; }

  /* Strap: the lanyard's woven band, carrying navigation */
  .strap {
    position: sticky; top: 0; z-index: 5;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    height: 3rem; padding: 0 var(--gutter);
    background: var(--strap); color: var(--accent);
    font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .strap-name { white-space: nowrap; }
  .strap ul { display: flex; gap: clamp(0.75rem, 2.5vw, 2rem); margin-left: auto; }
  .strap a { text-decoration: none; display: block; padding: 0.75rem 0 0.6rem; border-bottom: 4px solid transparent; }
  .strap a:hover { border-bottom-style: double; border-bottom-color: currentColor; }
  .strap a[aria-current] { border-bottom-color: currentColor; color: var(--strap-ink); }
  /* The strap is dark in both themes, so its focus ring uses the fixed strap ink. */
  .strap :focus-visible { outline-color: var(--strap-ink); }
  .theme {
    flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-right: -0.6rem;
    background: none; border: 0; color: inherit; cursor: pointer; border-bottom: 4px solid transparent;
  }
  .theme:hover { border-bottom-style: double; border-bottom-color: currentColor; }
  .theme svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* Show the mode the button switches to. */
  .icon-moon, [data-theme='light'] .icon-sun { display: none; }
  [data-theme='light'] .icon-moon { display: block; }

  /* Front of the badge */
  .front {
    position: relative; overflow: clip;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    grid-template-rows: auto auto 1fr;
    column-gap: clamp(2rem, 6vw, 7rem);
    padding: 1.25rem var(--gutter) clamp(3rem, 8vh, 6rem);
    min-height: calc(100svh - 3rem);
    align-content: start;
  }
  .lede {
    grid-column: 1; align-self: end;
    font-size: var(--display); font-weight: 800; line-height: 0.95; letter-spacing: -0.015em;
    text-wrap: balance; max-width: 12ch;
    margin-top: clamp(2rem, 14vh, 9rem);
  }
  .proof { grid-column: 1; margin-top: 1.5rem; max-width: 34ch; font-weight: 600; }
  .proof a { font-weight: 800; white-space: nowrap; display: inline-block; padding-block: 0.6rem; margin-block: -0.6rem; }
  /* Particles: faint dots drifting behind the front's content (drawn by the script). */
  .front { isolation: isolate; }
  .particles { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }
  .hang { grid-column: 2; grid-row: 1 / span 3; position: relative; padding-top: 2.75rem; }

  .lanyard {
    position: absolute; right: calc(50% - 1rem); top: 0.25rem;
    width: 160vw; height: 2.75rem;
    transform-origin: right center; transform: rotate(-45deg);
    background: var(--strap); color: var(--accent);
    display: flex; align-items: center; justify-content: flex-end; overflow: hidden;
    font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; white-space: nowrap;
